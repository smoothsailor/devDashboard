<idea-plugin>
    <id>com.yourname.devpulse</id>
    <name>devDashboard</name>
    <vendor email="zyj_915@126.com" url="https://github.com/smoothsailor/devDashboard/issues">devDashboard</vendor>

    <description>
        DevDashboard brings your GitHub stats directly into your IDE. View total stars, daily star growth, open issues, and pull requests without leaving IntelliJ IDEA. Stay informed and motivated at a glance.
    </description>

    <!-- 依赖声明 -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- 扩展点注册 -->
    <extensions defaultExtensionNs="com.intellij">
        <!-- 1. 注册侧边栏工具窗口 -->
        <toolWindow
            id="DevDashboard"
            anchor="right"
            icon="/icons/logo.svg"
            factoryClass="com.yourname.devpulse.ui.DashboardToolWindowFactory"
            canCloseContents="false"/>

        <!-- 2. 注册设置页面 (Settings -> Tools -> DevPulse) -->
        <projectConfigurable
            parentId="tools"
            instance="com.yourname.devpulse.settings.DevPulseSettingsConfigurable"
            id="com.yourname.devpulse.settings"
            displayName="DevDashboard"/>

        <!-- 3. 应用启动监听 (StartupActivity 通过扩展点注册) -->
        <postStartupActivity implementation="com.yourname.devpulse.DevPulseStartupActivity"/>
    </extensions>
</idea-plugin>
